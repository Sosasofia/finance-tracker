{
  "tasks": [
    {
      "name": "backend-format",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["format", "./FinanceTracker.sln", "--verify-no-changes"]
    },
    {
      "name": "frontend-lint",
      "group": "pre-push",
      "command": "npm",
      "args": ["--prefix", "financetracker.client", "run", "lint"]
    },
    {
      "name": "backend-test",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["test", "FinanceTracker.Test/FinanceTracker.Test.csproj"]
    },
    {
      "name": "frontend-test",
      "group": "pre-push",
      "command": "npm",
      "args": ["--prefix", "financetracker.client", "run", "test", "--", "--watch=false", "--browsers=ChromeHeadless"]
    }
  ]
}